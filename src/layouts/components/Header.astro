---
import { Icon } from 'astro-icon/components'
import Burger from './Burger.astro';

const basePath = import.meta.env.BASE_URL;
---

<script>
  const burgerEl = document.querySelector('.o-burger');
  const menuEl = document.querySelector('.l-header__menu');

  let isOpened = false;
  burgerEl?.addEventListener('click', function() {
    if (!isOpened) {
      burgerEl.classList.add('is-opened');
      menuEl?.classList.add('is-opened');
      isOpened = true;
    } else {
      burgerEl.classList.remove('is-opened');
      menuEl?.classList.remove('is-opened');
      isOpened = false;
    }
  })
</script>

<header class="l-header">
  <a href=`${basePath}` class="z-10">
    <figure class="max-w-50">
      <img src=`${basePath}/img/logo/logo.svg` alt="大港開唱 Logo">
    </figure>
  </a> 

  <div class="l-header__burger">
    <Burger />
  </div>

  <div class="l-header__menu">
    <nav class="l-header__nav">
      <ul class="l-header__btn-box">
        <li class="l-header__btn-wrap">
          <a href="##" class="l-header__btn">
            <span class="l-header__text-en">LINEUP</span>
            <span>演出陣容</span>
          </a>
        </li>
        <li class="l-header__btn-wrap">
          <a href="##" class="l-header__btn">
            <span class="l-header__text-en">NEWS</span>
            <span>最新消息</span>
          </a>
        </li>
        <li class="l-header__btn-wrap">
          <a href="##" class="l-header__btn">
            <span class="l-header__text-en">ABOUT</span>
            <span>關於大港</span>
          </a>
        </li>
        <li class="l-header__btn-wrap">
          <a href="##" class="l-header__btn">
            <span class="l-header__text-en">TIMETABLE</span>
            <span>節目流程</span>
          </a>
        </li>
        <li class="l-header__btn-wrap">
          <a href="##" class="l-header__btn">
            <span class="l-header__text-en">TICKET</span>
            <span>購票資訊</span>
          </a>
        </li>
        <li class="l-header__btn-wrap">
          <a href="##" class="l-header__btn">
            <span class="l-header__text-en">MAP</span>
            <span>地圖導覽</span>
          </a>
        </li>
      </ul>
      <ul class="l-header__btn-box --social">
        <li class="l-header__btn-wrap">
          <a href="##" class="l-header__btn">
            <Icon name="mingcute:facebook-fill" class="u-icon-md" />
          </a>
        </li>
        <li class="l-header__btn-wrap">
          <a href="##" class="l-header__btn">
            <Icon name="mingcute:instagram-fill" class="u-icon-md" />
          </a>
        </li>
        <li class="l-header__btn-wrap">
          <a href="##" class="l-header__btn">
            <Icon name="mingcute:youtube-fill" class="u-icon-md" />
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style lang="scss">
  // @use '../../styles/scss/mixins' as *;

  // @media (max-width: 1399.98px) {
  //   .l-header__menu {}
  // }
  .l-header {
    position: sticky;
    top: 0;
    left: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: var(--color-black);
    // padding: var(--spacing-4) 4vw;
    // padding-left: var(--spacing-20);
    padding-left: 4vw;
    border-bottom: 1px solid var(--color-primary);
    box-shadow: 0 var(--spacing-1) var(--spacing-14) var(--color-primary);
    z-index: 20;

    @include media('max-2xl') {
      padding: var(--spacing-4) 4vw;
    }

    &__burger {
      display: none;
      z-index: 10;
      @include media('max-2xl') {
        display: block;
      }
    }

    &__menu {
      display: flex;
      // 不用上面justify-content: space-between; 時用 margin-left: auto;。
      // margin-left: auto;
      // gap: 4vw;
      @include media('max-2xl') {
        position: fixed;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        background-color: var(--color-black-80);
        overflow: auto;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.5s;
        &.is-opened {
          opacity: 1;
          pointer-events: auto;
        }
      }
    }

    &__nav {
      display: flex;
      @include media('max-2xl') {
        width: 100%;
        height: 100%;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        padding: var(--spacing-20);
      }
    }

    // @include media('max-2xl') {
    //     &__menu {
    //     }
    // }
    
    &__btn-box {
      display: flex;
      // gap: 2vw;
      // text-align: center;

      @include media('max-md') {
        &:not(.--social) {
          flex-direction: column;
          align-items: center;
          text-align: center;
        }
      }
    }
    
    // &__btn-box.--social &__btn {}
    &__btn-box.--social &__btn {
      // 重新賦值
      --gradient-color: var(--color-secondary);

      background-color: var(--color-gray);
      padding-right: 1.2vw;
      padding-left: 1.2vw;
      display: flex;
      align-items: center;

      @include media('max-2xl') {
        background-color: transparent;
        &::after {
          display: none;
        }
      }

      &::after {
        --gradient-color: var(--color-secondary);
      }

      // &:hover {
      //   background-color: var(--color-secondary);
      // }
    }

    &__btn {
      --gradient-color: var(--color-primary);
      position: relative;
      padding: var(--spacing-6) 2.8vw;
      // background-color: var(--color-gray);
      // border-left: 1px solid var(--color-white);
      color: var(--color-gray-mid);
      height: 100%;
      transition-property: background, color;
      transition-duration: 0.25s;

      &:hover {
        // background-color: var(--color-primary);
        color: var(--color-gray-light);
      }

      // 子選擇器 + 通用選擇器
      // 選擇 &__btn 子層所有元素
      // 因為只有 before 設定 position，會導致其他兄弟層未照 html 上下自然排序
      // 所以兄弟層都加入 position 就可以開啟 z-index 進行排列
      > * {
        position: relative;
      }

      // .l-header__btn:hover {}
      // .l-header__btn::before {}

      &::before, &::after {
        content: '';
        display: block;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
        background-image: linear-gradient(to bottom, var(--gradient-color), transparent);
      }

      // &::before {
      //   content: '';
      //   display: block;
      //   height: 100%;
      //   // background-color: var(--color-primary);
      //   // 父層要記得設定相對定位
      //   position: absolute;
      //   top: 0;
      //   left: 0;
      //   width: 100%;
      //   background-image: linear-gradient(to bottom, var(--color-primary), transparent);
      //   opacity: 0;
      //   transition: opacity 0.25s;
      // }

      &::before {
        width: 100%;
        opacity: 0;
        transition: opacity 0.25s;
      }
      
      // &:hover span {}
      &:hover::before {
        opacity: 1;
      }

      &::after {
        --gradient-color: var(--color-gray-light);
        width: 1px;
        @include media('max-md') {
          display: none;
        }
      }
    }
    @include media('max-2xl') {
      &__btn-wrap:first-child &__btn::after {
        display: none;
      }
    }

    &__text-en {
      font-family: var(--font-en);
      font-size: var(--text-lg);
      font-weight: 900;
      letter-spacing: var(--tracking-tight);
    }
  }
  // .l-header__btn-box.--social .l-header__btn {}
</style>