---
import { getCollection } from 'astro:content';
import SectionTitle from "../SectionTitle.astro";
import ArtistCard from "../ArtistCard.astro";

const artistList = await getCollection('artists');
---

<section id="lineup" class="--gradient l-home-lineup pb-0">
  <div class="l-container">
    <SectionTitle title="LINEUP" class="mb-20"/>

    <div class="grid --gap grid-cols-1 md:grid-cols-12">
      <div class="md:col-span-5 flex justify-end items-end">
        <ArtistCard
        data={artistList[0].data}
      />
      </div>
      <div class="md:col-span-7">
        <ArtistCard
        data={artistList[1].data} 
        size="lg"
      />
      </div>
      <div class="md:col-span-7 lg:col-span-4">
        <ArtistCard
        data={artistList[2].data} 
        size="lg"
        reverse={true}
      />
      </div>
      <div class="md:col-span-5 lg:col-span-4 flex justify-center">
        <ArtistCard
        data={artistList[3].data}
        reverse
      />
      </div>
      <div class="md:col-span-5 lg:col-span-4 md:col-start-3 lg:col-start-0">
        <ArtistCard
        data={artistList[4].data}
        reverse
      />
      </div>
    </div>
  </div>
</section>