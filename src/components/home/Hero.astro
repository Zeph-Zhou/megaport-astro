  </figure>
</div> -->

<style lang="scss">
  .l-home-hero {
    height: 100vh;

    @include media(max-sa) {
      height: 80vh;
    }

    &__slide.swiper-slide-active &__img-mask {
      transform: scale(1.1);
    }

    &__img-mask {
      transform: scale(1);
      transition: transform 15s;
    }
  }
</style>